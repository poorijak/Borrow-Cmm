generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActiveStatus {
  Active
  Inactvie
}

enum UserRole {
  Administrater
  Moderater
  Student
  Instructor
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role     UserRole  @default(Student)
  accounts Account[]
}

model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?
  expiresAt    Int?
  scope        String?
  tokenType    String?
  idToken      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model EquipmentCategory {
  id                     String                 @id @default(uuid())
  title                  String
  mainImage              String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  status                 ActiveStatus
  equipmentSubCategories EquipmentSubCategory[]
}

model EquipmentSubCategory {
  id             String            @id @default(uuid())
  title          String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  mainCategoryId String
  mainCategory   EquipmentCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  status         ActiveStatus
}


