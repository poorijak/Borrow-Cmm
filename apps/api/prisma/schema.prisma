generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActiveStatus {
  active
  inactive
}

enum TimeSlot {
  morning
  afternoon
}

enum BookingStatus {
  pending
  approved
  rejected
  in_use
  completed
  cancelled
}

enum UserRole {
  administrater
  moderater
  student
  instructor
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  borrowedQTY  Int      @default(0)
  overDueQTY   Int      @default(0)

  role     UserRole    @default(student)
  accounts Account[]
  bags     BorrowBag[]
}

model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?
  expiresAt    Int?
  scope        String?
  tokenType    String?
  idToken      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model EquipmentCategory {
  id                     String                 @id @default(uuid())
  title                  String
  mainImage              String
  code                   String                 @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  status                 ActiveStatus
  equipmentSubCategories EquipmentSubCategory[]
}

model EquipmentSubCategory {
  id             String            @id @default(uuid())
  title          String
  code           String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  mainCategoryId String
  mainCategory   EquipmentCategory @relation(fields: [mainCategoryId], references: [id])
  status         ActiveStatus
  equipment      Equipment[]
}

model Equipment {
  id                String               @id @default(uuid())
  mainImage         String
  title             String               @unique
  description       String?
  totalStock        Int
  borrowedQty       Int
  reservedQty       Int
  totalBorrowed     Int
  status            ActiveStatus
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  subCategoryId     String
  category          EquipmentSubCategory @relation(fields: [subCategoryId], references: [id])
  bagEquipmentItems BagEquipmentItem[]
}

model Course {
  id        String       @id @default(uuid())
  code      String       @unique
  label     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  status    ActiveStatus
}

model Laboratory {
  id            String       @id @default(uuid())
  name          String
  labCode       String       @unique
  totalBorrowed Int
  status        ActiveStatus
  image         String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  labBookings   LabBooking[]
  bagLabItems   BagLabItem[]
}

model LabBooking {
  id           String        @id @default(uuid())
  laboratoryId String
  bookingDate  DateTime
  slot         TimeSlot
  status       BookingStatus
  reservedAt   DateTime      @default(now())
  expiresAt    DateTime

  approvedById   String?
  approvedByRole UserRole?
  approvedAt     DateTime?

  rejectedById   String?
  rejectedByRole UserRole?
  rejectedAt     DateTime?

  laboratory Laboratory @relation(fields: [laboratoryId], references: [id])

  @@unique([laboratoryId, slot, bookingDate])
}

model BorrowBag {
  id             String             @id @default(uuid())
  itemCount      Int                @default(0)
  totalQty       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String
  owner          User               @relation(fields: [userId], references: [id])
  equipmentItems BagEquipmentItem[]
  labItems       BagLabItem[]
}

model BagEquipmentItem {
  id        String @id @default(uuid())
  itemCount Int    @default(1)

  bagId String
  bag   BorrowBag @relation(fields: [bagId], references: [id])

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  isSelected Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bagId, equipmentId])
}

model BagLabItem {
  id String @id @default(uuid())

  bagId     String
  borrowBag BorrowBag @relation(fields: [bagId], references: [id])

  labId      String
  laboratory Laboratory @relation(fields: [labId], references: [id])

  date       DateTime
  slot       TimeSlot
  isSelected Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([labId, bagId, date, slot])
}
